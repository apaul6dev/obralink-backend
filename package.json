{
  "name": "backend-obralink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:local": "npm run db:up && npm run migration:run && npm run start:dev",
    "start:dev": "nest start --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/shared/infrastructure/database/typeorm-data-source.ts",
    "migration:show": "typeorm-ts-node-commonjs migration:show -d src/shared/infrastructure/database/typeorm-data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/shared/infrastructure/database/typeorm-data-source.ts",
    "seed:global-admin": "ts-node -r tsconfig-paths/register src/shared/infrastructure/database/seeds/seed-global-admin.ts",
    "seed:roles": "ts-node -r tsconfig-paths/register src/shared/infrastructure/database/seeds/seed-roles.ts",
    "seed:run": "npm run seed:roles && npm run seed:global-admin",
    "setup:local": "npm install && npm run db:up && npm run migration:run && npm run seed:run"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "eslint": "^9.17.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
